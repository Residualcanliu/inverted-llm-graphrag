# 环境
.env
.venv/
venv/
__pycache__/
*.py[cod]

# 数据（原始文档可能含企业信息，不入库）
data/raw/*
!data/raw/.gitkeep

# 生成物
data/triples.json
data/index/
reports/*.html
logs/
*.log

# 向量索引：从 dense 数据可重建，而且含二进制
data/doc_index/

# 对比实验的过程文件
data/*.general.json

# 评测中间结果
eval_runs/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
.pytest_cache/
.ruff_cache/

# 个人文件，不入公开仓库
个人笔记.txt
*.local.md

# 合作方材料生成的 Word，只留本地（md 设计文档照常进仓库）
docs/*.docx
