# 复制为 .env 后按需修改。.env 已在 .gitignore 里，不会被提交。

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please_change_me

# 只读保证不靠独立的数据库账号 —— 社区版不支持 RBAC（GRANT ROLE 会报
# UnsupportedAdministrationCommand），建出来的"只读账号"能随意增删改。
# 改用 driver 的 READ_ACCESS 模式，服务端会强制拒绝写入。
# 详见 app/graph/client.py 文件头的说明。

# ---------- Ollama ----------
# 变量名不要用 OLLAMA_HOST —— 那是 Ollama 服务端自己的变量（监听地址），
# 重名会导致 .env 被忽略，程序拿到 "0.0.0.0:11434" 这种不可用的值。
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 生成模型（由 scripts/bench_models.py 实测选定后填入）
GEN_MODEL=qwen2.5-coder:14b

# judge 模型：必须与生成模型不同家族，避免自我偏好偏差
JUDGE_MODEL=deepseek-r1:14b

# 嵌入模型（传统 RAG 基线用）
EMBED_MODEL=bge-m3

# ---------- 生成参数 ----------
# Cypher 生成要精确复现，不要多样性
GEN_TEMPERATURE=0.1
GEN_NUM_PREDICT=512

# 自修复上限。调研结论：前 2 次拿走绝大部分收益，第 3 次后基本不收敛
MAX_REPAIR_ROUNDS=2

# ---------- 传统 RAG 基线 ----------
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K=5

# ---------- 路径 ----------
DATA_DIR=data
REPORT_DIR=reports
